{
  "manifest_version": 3,
  "name": "Wingo Snapshot Monitor",
  "version": "2.0.0",
  "description": "Captures matching WinGo API responses from the game page and stores period-wise snapshots locally, with optional Firebase backup.",
  "permissions": ["storage", "tabs", "downloads"],
  "host_permissions": ["https://api.ar-lottery01.com/*", "https://*.firebaseio.com/*", "https://*.firebasedatabase.app/*", "https://identitytoolkit.googleapis.com/*", "https://securetoken.googleapis.com/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {"matches": ["http://*/*", "https://*/*"], "js": ["page-hook.js"], "run_at": "document_start", "world": "MAIN"},
    {"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_start", "world": "ISOLATED"}
  ],
  "action": {"default_title": "Wingo Snapshot Monitor", "default_popup": "popup.html"}
}
